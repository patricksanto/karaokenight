<%# Projetor — tela fullscreen para telão. Sem layout padrão. %>
<% content_for :head do %>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #0D0A15;
      color: #FAF7FF;
      font-family: 'Inter', sans-serif;
      height: 100vh;
      overflow: hidden;
    }

    /* ══════════════════════════
       LAYOUT PRINCIPAL
    ══════════════════════════ */
    .proj {
      display: flex;
      flex-direction: column;
      height: 100vh;
      padding: 14px 20px 16px;
      gap: 12px;
    }

    /* ── STATUS BAR ── */
    .proj-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      height: 28px;
    }
    .bar-left  { display: flex; align-items: center; gap: 14px; }
    .bar-right { display: flex; align-items: center; gap: 20px; }

    .live-pill {
      display: inline-flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,.05);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 999px; padding: 3px 10px;
    }
    .live-dot {
      width: 7px; height: 7px;
      background: #D5FF70; border-radius: 999px;
      animation: blink 1.4s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }
    .live-label {
      font-size: 11px; font-weight: 600;
      letter-spacing: .06em; text-transform: uppercase;
      color: #FAF7FF;
    }
    .bar-room {
      font-size: 11px; font-weight: 600;
      letter-spacing: .06em; text-transform: uppercase;
      color: #BEB2CF;
    }
    .bar-room strong { color: #D5FF70; }

    .bar-stat {
      display: flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 600;
      letter-spacing: .05em; text-transform: uppercase;
      color: #BEB2CF;
    }
    .bar-stat-val {
      background: rgba(213,255,112,.12);
      border: 1px solid rgba(213,255,112,.2);
      border-radius: 4px; padding: 1px 7px;
      font-size: 11px; font-weight: 700;
      color: #D5FF70;
      transition: background .3s, color .3s;
    }
    .bar-stat-val.flash {
      background: #D5FF70; color: #171022;
    }

    /* ── BODY: 3 COLUNAS ── */
    .proj-body {
      flex: 1;
      display: grid;
      grid-template-columns: 5fr 4fr 3fr;
      gap: 14px;
      min-height: 0;
    }

    .proj-col {
      border-radius: 18px;
      position: relative;
      overflow: hidden;
    }

    /* ══════════════════════════
       COL 1 — NOW SINGING
    ══════════════════════════ */
    .col-singer {
      background: #161121;
      border: 1px solid rgba(255,255,255,.06);
      display: flex;
      align-items: center;
      gap: 24px;
      padding: 24px 28px;
    }

    /* subtle glow */
    .col-singer::before {
      content: '';
      position: absolute;
      width: 220px; height: 220px;
      background: rgba(200,241,100,.04);
      border-radius: 999px;
      filter: blur(40px);
      bottom: -60px; left: -40px;
      pointer-events: none;
    }

    .singer-avatar {
      width: 100px; height: 100px;
      background: #2C223D;
      border: 2px solid #D5FF70;
      border-radius: 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 58px; line-height: 1;
      flex-shrink: 0;
      position: relative;
    }
    .singer-mic-badge {
      position: absolute; bottom: -8px; right: -8px;
      width: 26px; height: 26px;
      background: #D5FF70; border-radius: 999px;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px;
    }

    .singer-info { flex: 1; min-width: 0; }

    .singer-tag {
      display: inline-flex; align-items: center; gap: 6px;
      margin-bottom: 6px;
    }
    .singer-badge {
      background: rgba(173,128,255,.15);
      border: 1px solid rgba(173,128,255,.3);
      border-radius: 4px; padding: 2px 8px;
      font-size: 11px; font-weight: 700;
      letter-spacing: .06em; text-transform: uppercase;
      color: #AD80FF;
    }
    .singer-name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800; font-size: 46px;
      line-height: 1; letter-spacing: -.03em;
      color: #FAF7FF;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin-bottom: 6px;
    }
    .singer-song {
      font-size: 20px; font-weight: 600;
      color: #FAF7FF; margin-bottom: 3px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .singer-artist {
      font-size: 15px; color: #BEB2CF;
    }

    .singer-wave {
      display: flex; align-items: flex-end; gap: 3px;
      height: 18px; margin-top: 14px;
    }
    .wave-bar {
      width: 4px; background: #D5FF70; border-radius: 999px;
      animation: eq .9s ease-in-out infinite alternate;
    }
    .wave-bar:nth-child(1){height:8px; animation-delay:0s}
    .wave-bar:nth-child(2){height:16px;animation-delay:.08s}
    .wave-bar:nth-child(3){height:6px; animation-delay:.16s}
    .wave-bar:nth-child(4){height:18px;animation-delay:.12s}
    .wave-bar:nth-child(5){height:10px;animation-delay:.04s}
    .wave-bar:nth-child(6){height:14px;animation-delay:.2s}
    .wave-bar:nth-child(7){height:7px; animation-delay:.1s}
    @keyframes eq { from{transform:scaleY(.3)} to{transform:scaleY(1)} }

    /* empty / reveal states */
    .singer-empty {
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      width: 100%; height: 100%;
      gap: 12px; opacity: .4;
    }
    .singer-empty-icon { font-size: 56px; animation: float 2.5s ease-in-out infinite; }
    @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
    .singer-empty-text {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700; font-size: 17px;
      color: #BEB2CF; text-align: center;
    }

    /* ══════════════════════════
       COL 2 — LIVE SCORE + REAÇÕES
    ══════════════════════════ */
    .col-score {
      background: #161121;
      border: 1px solid rgba(255,255,255,.06);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0;
      padding: 20px 24px;
    }

    /* subtle lime glow on score panel */
    .col-score::after {
      content: '';
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at 50% 40%, rgba(213,255,112,.04) 0%, transparent 70%);
      pointer-events: none;
    }

    .score-section {
      display: flex; flex-direction: column; align-items: center;
      flex: 1; justify-content: center; width: 100%;
    }

    .score-eyebrow {
      font-size: 11px; font-weight: 700;
      letter-spacing: .12em; text-transform: uppercase;
      color: #BEB2CF; margin-bottom: 8px;
    }

    .score-number {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 900; font-size: 96px; line-height: 1;
      letter-spacing: -.05em;
      color: #D5FF70;
      transition: transform .2s cubic-bezier(.175,.885,.32,1.275);
    }
    .score-number.pop {
      animation: score-pop .35s cubic-bezier(.175,.885,.32,1.275) both;
    }
    @keyframes score-pop {
      0%  { transform: scale(.8); opacity:.5; }
      60% { transform: scale(1.08); }
      100%{ transform: scale(1);   opacity:1; }
    }
    .score-number.pending { color: rgba(213,255,112,.25); font-size: 72px; }

    .score-denom {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700; font-size: 24px;
      color: #BEB2CF; margin-top: 2px; margin-bottom: 8px;
    }
    .score-votes {
      font-size: 12px; color: #BEB2CF;
      letter-spacing: .02em;
    }
    .score-votes strong { color: #FAF7FF; }

    /* ── Emoji reactions row ── */
    .reactions-row {
      display: flex; align-items: center;
      justify-content: center; gap: 10px;
      padding-top: 18px;
      border-top: 1px solid rgba(255,255,255,.06);
      width: 100%; margin-top: 18px;
    }
    .reaction-item {
      display: flex; flex-direction: column; align-items: center; gap: 3px;
      cursor: default;
    }
    .reaction-emoji { font-size: 26px; line-height: 1; }
    .reaction-count {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700; font-size: 12px;
      color: #BEB2CF;
      min-width: 20px; text-align: center;
      transition: color .2s;
    }
    .reaction-item.active .reaction-count { color: #D5FF70; }

    /* ══════════════════════════
       COL 3 — FILA + QR
    ══════════════════════════ */
    .col-queue {
      background: #161121;
      border: 1px solid rgba(255,255,255,.06);
      display: flex; flex-direction: column; gap: 12px;
      padding: 20px 18px;
    }

    .queue-header {
      display: flex; align-items: center; justify-content: space-between;
      flex-shrink: 0;
    }
    .queue-title {
      font-size: 11px; font-weight: 700;
      letter-spacing: .08em; text-transform: uppercase;
      color: #BEB2CF;
    }
    .queue-count {
      font-size: 11px; color: #554565;
    }

    .queue-items { display: flex; flex-direction: column; gap: 6px; flex: 1; }

    .queue-item {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 10px; border-radius: 10px;
      border: 1px solid rgba(255,255,255,.04);
      background: rgba(255,255,255,.02);
      cursor: pointer; text-decoration: none;
      transition: background .15s, border-color .15s;
    }
    .queue-item:hover { background: rgba(213,255,112,.05); border-color: rgba(213,255,112,.2); }
    .queue-item.next { background: #1E1730; border-color: rgba(213,255,112,.15); }

    .queue-num {
      width: 18px; height: 18px;
      background: rgba(255,255,255,.06); border-radius: 4px;
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; font-weight: 700; color: #BEB2CF;
      flex-shrink: 0;
    }
    .queue-item.next .queue-num { background: #D5FF70; color: #171022; }

    .queue-info { flex: 1; min-width: 0; }
    .queue-name {
      font-size: 12px; font-weight: 700; color: #FAF7FF;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .queue-song {
      font-size: 11px; color: #BEB2CF;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin-top: 1px;
    }
    .queue-time { font-size: 10px; color: #554565; flex-shrink: 0; }

    .queue-empty {
      flex: 1; display: flex; align-items: center; justify-content: center;
      font-size: 13px; color: #554565; text-align: center;
    }

    .qr-card {
      flex-shrink: 0;
      background: #FAF7FF; border-radius: 12px;
      padding: 10px; display: flex; flex-direction: column;
      align-items: center; gap: 4px;
    }
    .qr-card svg { width: 72px; height: 72px; }
    .qr-label {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 900; font-size: 9px;
      letter-spacing: -.01em; text-transform: uppercase;
      color: #100C19; text-align: center; line-height: 1.2;
    }
    .qr-code { font-size: 8px; color: #554565; font-family: monospace; }

    /* ══════════════════════════
       REVEAL STATE overrides
    ══════════════════════════ */
    .proj.revealed .col-singer { border-color: rgba(213,255,112,.2); }
    .proj.revealed .col-score  {
      border-color: #D5FF70;
      background: linear-gradient(160deg, #1E1A2E 0%, #161121 100%);
    }
    .proj.revealed .score-number { color: #D5FF70; font-size: 96px; }
    .singer-badge.revealed-badge {
      background: rgba(213,255,112,.12) !important;
      border-color: rgba(213,255,112,.3) !important;
      color: #D5FF70 !important;
    }
    .singer-song.revealed { color: #D5FF70; }

    /* ══════════════════════════
       MENSAGENS FLUTUANTES
    ══════════════════════════ */
    #float-zone {
      position: fixed;
      bottom: 80px; left: 50%; transform: translateX(-50%);
      width: 600px; max-width: 90vw;
      display: flex; flex-direction: column; align-items: center;
      gap: 10px;
      pointer-events: none;
      z-index: 200;
    }

    .float-msg {
      background: rgba(22,17,33,.92);
      border: 1px solid rgba(213,255,112,.25);
      border-radius: 12px;
      padding: 10px 18px;
      max-width: 500px;
      text-align: center;
      animation: msg-float 6s ease-out forwards;
    }
    .float-msg-text {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700; font-size: 18px;
      color: #FAF7FF; line-height: 1.3;
    }
    .float-msg-text::before { content: '"'; color: #D5FF70; }
    .float-msg-text::after  { content: '"'; color: #D5FF70; }

    @keyframes msg-float {
      0%   { opacity: 0; transform: translateY(0px) scale(.9); }
      10%  { opacity: 1; transform: translateY(-10px) scale(1); }
      70%  { opacity: 1; transform: translateY(-60px); }
      100% { opacity: 0; transform: translateY(-120px); }
    }

    /* ════════════════════════════════════════
       HYPE BACKGROUND — Concert Lighting
    ════════════════════════════════════════ */

    #hype-bg {
      position: fixed; inset: 0;
      pointer-events: none;
      z-index: 250;
      overflow: hidden;
    }

    /* ── Base: blobs ── */
    .hb-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(70px);
      opacity: 0;
      transition: opacity 1.4s ease;
      mix-blend-mode: screen;
    }
    .hb-blob-1 { width: 520px; height: 520px; bottom: -80px; left: -60px;  }
    .hb-blob-2 { width: 420px; height: 420px; top:   -60px;  right: -40px; }
    .hb-blob-3 { width: 320px; height: 320px; bottom: 18%;   right: 10%;   }
    .hb-blob-4 { width: 360px; height: 360px; top:    8%;    left:  18%;   }

    .hb-beam {
      position: absolute;
      top: -20px;
      width: 5px; height: 130vh;
      opacity: 0;
      transform-origin: top center;
      mix-blend-mode: screen;
    }
    .hb-beam-1 { left: 18%; transform: rotate(12deg);  background: linear-gradient(to bottom, #c8f164 0%, transparent 80%); }
    .hb-beam-2 { left: 50%; transform: rotate(-8deg);  background: linear-gradient(to bottom, #ad80ff 0%, transparent 80%); }
    .hb-beam-3 { left: 78%; transform: rotate(16deg);  background: linear-gradient(to bottom, #ff87c8 0%, transparent 80%); }

    .hb-edge {
      position: absolute; left: 0; right: 0;
      height: 3px; opacity: 0;
      mix-blend-mode: screen;
      transition: opacity 1s;
    }
    .hb-edge-top    { top: 0;    background: linear-gradient(to right, transparent 10%, #c8f164 50%, transparent 90%); }
    .hb-edge-bottom { bottom: 0; background: linear-gradient(to right, transparent 10%, #ad80ff 50%, transparent 90%); }

    /* ════════════════════
       HYPE LEVEL 1 — 10+ reactions
       Blobs lentos, breathing suave
    ════════════════════ */
    #hype-bg.hype-1 .hb-blob-1 {
      opacity: 1;
      background: radial-gradient(circle, #c8f164 0%, transparent 65%);
      animation: blob-breathe 4s ease-in-out infinite;
    }
    #hype-bg.hype-1 .hb-blob-2 {
      opacity: 1;
      background: radial-gradient(circle, #7b3fe4 0%, transparent 65%);
      animation: blob-breathe 4s ease-in-out infinite 1.5s;
    }

    @keyframes blob-breathe {
      0%,100% { transform: scale(1);    opacity: .6; }
      50%      { transform: scale(1.15); opacity: 1;  }
    }

    /* ════════════════════
       HYPE LEVEL 2 — 30+ reactions
       Blobs móveis + scanning beam
    ════════════════════ */
    #hype-bg.hype-2 .hb-blob-1 {
      opacity: 1;
      background: radial-gradient(circle, #c8f164 0%, transparent 65%);
      animation: blob-drift-1 5s ease-in-out infinite;
    }
    #hype-bg.hype-2 .hb-blob-2 {
      opacity: 1;
      background: radial-gradient(circle, #7b3fe4 0%, transparent 65%);
      animation: blob-drift-2 6s ease-in-out infinite;
    }
    #hype-bg.hype-2 .hb-blob-3 {
      opacity: 1;
      background: radial-gradient(circle, #ff87c8 0%, transparent 65%);
      animation: blob-breathe 3s ease-in-out infinite 0.8s;
    }
    #hype-bg.hype-2 .hb-beam-1 {
      opacity: 1;
      animation: beam-scan-1 4s ease-in-out infinite;
    }
    #hype-bg.hype-2 .hb-edge-top { opacity: 1; animation: edge-pulse 2s ease-in-out infinite; }

    @keyframes blob-drift-1 {
      0%   { transform: translate(0,   0)   scale(1);    opacity: .7; }
      25%  { transform: translate(60px,-40px) scale(1.1); opacity: 1;  }
      50%  { transform: translate(30px, 50px) scale(.95); opacity: .8; }
      75%  { transform: translate(-30px,20px) scale(1.05);opacity: 1;  }
      100% { transform: translate(0,   0)   scale(1);    opacity: .7; }
    }
    @keyframes blob-drift-2 {
      0%   { transform: translate(0,  0)    scale(1);    opacity: .7; }
      33%  { transform: translate(-50px,40px) scale(1.12);opacity: 1;  }
      66%  { transform: translate(40px,-30px) scale(.9); opacity: .8; }
      100% { transform: translate(0,  0)    scale(1);    opacity: .7; }
    }
    @keyframes beam-scan-1 {
      0%,100% { opacity: 0;   transform: rotate(12deg) scaleX(1); }
      10%     { opacity: .7; }
      50%     { opacity: .4;  transform: rotate(25deg) scaleX(1.2); }
      90%     { opacity: .7; }
    }
    @keyframes edge-pulse {
      0%,100% { opacity: .4; }
      50%      { opacity: 1;  }
    }

    /* ════════════════════
       HYPE LEVEL 3 — 50+ reactions
       Full concert: beams múltiplos, color cycling, edge glow
    ════════════════════ */
    #hype-bg.hype-3 .hb-blob-1 {
      opacity: 1;
      animation: blob-color-1 3s ease-in-out infinite, blob-drift-1 4s ease-in-out infinite;
    }
    #hype-bg.hype-3 .hb-blob-2 {
      opacity: 1;
      animation: blob-color-2 4s ease-in-out infinite, blob-drift-2 5s ease-in-out infinite;
    }
    #hype-bg.hype-3 .hb-blob-3 {
      opacity: 1;
      animation: blob-color-3 3.5s ease-in-out infinite 0.5s, blob-breathe 2.5s ease-in-out infinite;
    }
    #hype-bg.hype-3 .hb-blob-4 {
      opacity: 1;
      background: radial-gradient(circle, #c8f164 0%, transparent 65%);
      animation: blob-drift-2 3.5s ease-in-out infinite 1s reverse;
    }
    #hype-bg.hype-3 .hb-beam-1 {
      opacity: 1;
      width: 4px;
      animation: beam-concert-1 2.5s ease-in-out infinite;
    }
    #hype-bg.hype-3 .hb-beam-2 {
      opacity: 1;
      width: 3px;
      animation: beam-concert-2 3s ease-in-out infinite 0.8s;
    }
    #hype-bg.hype-3 .hb-beam-3 {
      opacity: 1;
      width: 4px;
      animation: beam-concert-3 2.8s ease-in-out infinite 1.4s;
    }
    #hype-bg.hype-3 .hb-edge-top    { opacity: 1; animation: edge-concert 1.2s ease-in-out infinite; }
    #hype-bg.hype-3 .hb-edge-bottom { opacity: 1; animation: edge-concert 1.2s ease-in-out infinite 0.6s; }

    /* ── Disco spots ── */
    .hb-disco {
      position: absolute;
      width: 140px; height: 140px;
      border-radius: 50%;
      filter: blur(24px);
      opacity: 0;
      mix-blend-mode: screen;
    }
    .hb-disco-1 { background: #c8f164; }
    .hb-disco-2 { background: #ff87c8; }
    .hb-disco-3 { background: #ad80ff; }
    .hb-disco-4 { background: #00ffcc; }

    #hype-bg.hype-3 .hb-disco-1 { opacity: .9; animation: disco-1 1.8s linear infinite; }
    #hype-bg.hype-3 .hb-disco-2 { opacity: .8; animation: disco-2 2.1s linear infinite 0.3s; }
    #hype-bg.hype-3 .hb-disco-3 { opacity: .8; animation: disco-3 1.6s linear infinite 0.7s; }
    #hype-bg.hype-3 .hb-disco-4 { opacity: .7; animation: disco-4 2.4s linear infinite 1.1s; }

    @keyframes disco-1 {
      0%   { transform: translate(5vw,   5vh);  }
      25%  { transform: translate(75vw, 15vh);  }
      50%  { transform: translate(85vw, 75vh);  }
      75%  { transform: translate(15vw, 85vh);  }
      100% { transform: translate(5vw,   5vh);  }
    }
    @keyframes disco-2 {
      0%   { transform: translate(90vw, 85vh); }
      25%  { transform: translate(10vw, 70vh); }
      50%  { transform: translate(5vw,  10vh); }
      75%  { transform: translate(70vw,  5vh); }
      100% { transform: translate(90vw, 85vh); }
    }
    @keyframes disco-3 {
      0%   { transform: translate(45vw, 90vh); }
      20%  { transform: translate(90vw, 40vh); }
      40%  { transform: translate(55vw,  5vh); }
      60%  { transform: translate(5vw,  30vh); }
      80%  { transform: translate(20vw, 75vh); }
      100% { transform: translate(45vw, 90vh); }
    }
    @keyframes disco-4 {
      0%   { transform: translate(60vw, 50vh); }
      33%  { transform: translate(10vw, 10vh); }
      66%  { transform: translate(80vw,  5vh); }
      100% { transform: translate(60vw, 50vh); }
    }

    /* ── Strobe flash ── */
    .hb-strobe {
      position: absolute; inset: 0;
      background: white;
      opacity: 0;
    }
    #hype-bg.hype-3 .hb-strobe {
      mix-blend-mode: overlay;
      animation: strobe 1.1s ease-in-out infinite;
    }
    @keyframes strobe {
      0%    { opacity: 0;    }
      4%    { opacity: .22;  }
      8%    { opacity: 0;    }
      50%   { opacity: 0;    }
      54%   { opacity: .14;  }
      58%   { opacity: 0;    }
      100%  { opacity: 0;    }
    }

    @keyframes blob-color-1 {
      0%,100% { background: radial-gradient(circle, #c8f164 0%, transparent 65%); }
      33%     { background: radial-gradient(circle, #7b3fe4 0%, transparent 65%); }
      66%     { background: radial-gradient(circle, #c8f164 0%, transparent 65%); }
    }
    @keyframes blob-color-2 {
      0%,100% { background: radial-gradient(circle, #7b3fe4 0%, transparent 65%); }
      33%     { background: radial-gradient(circle, #ff87c8 0%, transparent 65%); }
      66%     { background: radial-gradient(circle, #c8f164 0%, transparent 65%); }
    }
    @keyframes blob-color-3 {
      0%,100% { background: radial-gradient(circle, #ff87c8 0%, transparent 65%); }
      50%     { background: radial-gradient(circle, #7b3fe4 0%, transparent 65%); }
    }

    /* Concert beams */
    @keyframes beam-concert-1 {
      0%,100% { opacity: 0;    transform: rotate(12deg); }
      15%,85% { opacity: .85; }
      50%     { opacity: .5;   transform: rotate(22deg); }
    }
    @keyframes beam-concert-2 {
      0%,100% { opacity: 0;    transform: rotate(-8deg); }
      20%,80% { opacity: .75; }
      50%     { opacity: .35;  transform: rotate(-18deg); }
    }
    @keyframes beam-concert-3 {
      0%,100% { opacity: 0;    transform: rotate(16deg); }
      15%,85% { opacity: .8; }
      50%     { opacity: .4;   transform: rotate(6deg); }
    }
    @keyframes edge-concert {
      0%,100% { opacity: .3; transform: scaleX(.7); }
      50%      { opacity: 1;  transform: scaleX(1);  }
    }

    /* ── TikTok Emoji Float ── */
    .ef-emoji {      position: absolute;
      bottom: 20px;
      transform: translateX(-50%);
      line-height: 1;
      user-select: none;
      pointer-events: none;
      animation: ef-rise 2s ease-out forwards;
    }
    @keyframes ef-rise {
      0%   { transform: translateX(-50%) translateY(0)      rotate(var(--rot, 0deg)) scale(.3);  opacity: 0; }
      8%   { transform: translateX(-50%) translateY(-40px)   rotate(var(--rot, 0deg)) scale(1.2); opacity: 1; }
      50%  { transform: translateX(calc(-50% + var(--sway, 0px) * .4)) translateY(-220px) rotate(calc(var(--rot, 0deg) * .5)) scale(1); opacity: 1; }
      85%  { opacity: .7; }
      100% { transform: translateX(calc(-50% + var(--sway, 0px))) translateY(-580px) rotate(0deg) scale(.5); opacity: 0; }
    }
  </style>
<% end %>

<%# ── Floating message zone (overlay) ── %>
<div id="float-zone"></div>

<%# ── Emoji float zone (TikTok-style reactions) ── %>
<div id="proj-emoji-float-zone" style="position:fixed;bottom:0;left:0;right:0;height:100vh;pointer-events:none;z-index:300;"></div>

<%# ── Hype background layers (progressive concert lighting) ── %>
<div id="hype-bg" aria-hidden="true">
  <div class="hb-blob hb-blob-1"></div>
  <div class="hb-blob hb-blob-2"></div>
  <div class="hb-blob hb-blob-3"></div>
  <div class="hb-blob hb-blob-4"></div>
  <div class="hb-beam hb-beam-1"></div>
  <div class="hb-beam hb-beam-2"></div>
  <div class="hb-beam hb-beam-3"></div>
  <div class="hb-edge hb-edge-top"></div>
  <div class="hb-edge hb-edge-bottom"></div>
  <%# Level 3 extras: disco spots + strobe %>
  <div class="hb-disco hb-disco-1"></div>
  <div class="hb-disco hb-disco-2"></div>
  <div class="hb-disco hb-disco-3"></div>
  <div class="hb-disco hb-disco-4"></div>
  <div class="hb-strobe"></div>
</div>

<div
  class="proj <%= 'revealed' if @performance&.revealed? %>"
  data-room-code="<%= @room.code %>"
>

  <%# ── STATUS BAR ── %>
  <div class="proj-bar">
    <div class="bar-left">
      <div class="live-pill">
        <div class="live-dot"></div>
        <span class="live-label">Live</span>
      </div>
      <span class="bar-room">ROOM <strong><%= @room.code %></strong></span>
    </div>
    <div class="bar-right">
      <% if @performance&.performing? || @performance&.closing? %>
        <div class="bar-stat">
          VOTES IN:
          <span class="bar-stat-val" id="proj-vote-count"><%= @performance.votes.count %></span>
        </div>
      <% elsif @performance&.revealed? %>
        <div class="bar-stat">
          ★ PERFORMANCE REVEAL —
          <span class="bar-stat-val"><%= @performance.votes_count %> ballots</span>
        </div>
      <% end %>
      <div class="bar-stat">
        <span>
          <% if @performance&.performing? %>VOTING OPEN
          <% elsif @performance&.closing? %>CLOSING...
          <% elsif @performance&.revealed? %>RESULT
          <% else %>STANDBY<% end %>
        </span>
      </div>
    </div>
  </div>

  <%# ── BODY ── %>
  <div class="proj-body">

    <%# ─── COL 1: NOW SINGING ─── %>
    <div class="proj-col col-singer">
      <% if @performance %>
        <% singer = @performance.singers.first %>
        <div class="singer-avatar">
          <%= singer&.emoji || "🎤" %>
          <div class="singer-mic-badge"><%= @performance.revealed? ? "⭐" : "🎤" %></div>
        </div>
        <div class="singer-info">
          <div class="singer-tag">
            <span class="singer-badge <%= 'revealed-badge' if @performance.revealed? %>">
              <%= @performance.revealed? ? "Completed" : "Now Singing" %>
            </span>
          </div>
          <div class="singer-name"><%= singer&.nickname || "Cantor" %></div>
          <div class="singer-song <%= 'revealed' if @performance.revealed? %>">
            <%= @performance.song_request.title %>
          </div>
          <div class="singer-artist"><%= @performance.song_request.artist %></div>
          <% unless @performance.revealed? %>
            <div class="singer-wave">
              <% 7.times do %><div class="wave-bar"></div><% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="singer-empty">
          <div class="singer-empty-icon">🎵</div>
          <div class="singer-empty-text">Aguardando próxima<br>apresentação</div>
        </div>
      <% end %>
    </div>

    <%# ─── COL 2: LIVE SCORE + REACTIONS ─── %>
    <div class="proj-col col-score">
      <div class="score-section">
        <div class="score-eyebrow">
          <%= @performance&.revealed? ? "⭐ FINAL CROWD SCORE" : "⭐ LIVE SCORE" %>
        </div>

        <% live_score = @performance&.votes&.average(:score)&.round(1) %>
        <div
          class="score-number <%= live_score ? '' : 'pending' %>"
          id="proj-live-score"
        >
          <%= live_score || "—" %>
        </div>

        <div class="score-denom">/ 10</div>
        <div class="score-votes" id="proj-score-sub">
          <% count = @performance&.votes&.count || 0 %>
          <% if count > 0 %>
            <strong><%= count %></strong> vote<%= count == 1 ? '' : 's' %> counted
          <% else %>
            Waiting for votes...
          <% end %>
        </div>
      </div>

      <%# ── Emoji reactions ── %>
      <div class="reactions-row">
        <% counts = @performance ? Reaction.counts_for(@performance) : {} %>
        <% [["🔥","fire"],["👏","clap"],["👑","crown"],["💖","heart"],["🪩","disco"]].each do |emoji, key| %>
          <div class="reaction-item <%= counts[key].to_i > 0 ? 'active' : '' %>" id="ri-<%= key %>">
            <span class="reaction-emoji"><%= emoji %></span>
            <span class="reaction-count" id="rc-<%= key %>"><%= counts[key] || 0 %></span>
          </div>
        <% end %>
      </div>
    </div>

    <%# ─── COL 3: QUEUE + QR ─── %>
    <div class="proj-col col-queue">
      <div class="queue-header">
        <span class="queue-title">Up Next</span>
        <span class="queue-count"><%= @queue.size %> waiting</span>
      </div>

      <div class="queue-items">
        <% if @queue.any? %>
          <% @queue.first(5).each_with_index do |sr, i| %>
            <%= form_with url: room_play_song_request_path(@room, sr), method: :post, data: { turbo: false } do %>
              <button type="submit" class="queue-item <%= i == 0 ? 'next' : '' %>">
                <span class="queue-num"><%= i + 2 %></span>
                <div class="queue-info">
                  <div class="queue-name"><%= sr.participant.nickname %></div>
                  <div class="queue-song"><%= sr.title %></div>
                </div>
                <span class="queue-time">~<%= (i+1)*3 %>m</span>
              </button>
            <% end %>
          <% end %>
        <% else %>
          <div class="queue-empty">Fila vazia</div>
        <% end %>
      </div>
    </div>

  </div>
</div>

<script>
  // ── Reaction counters (local por enquanto) ──
  const rc = { fire:0, clap:0, crown:0, heart:0, disco:0 };
  const rmap = { fire:'fire', claps:'clap', crown:'crown', sparkle:'disco' };

  function sendReaction(key) {
    rc[key] = (rc[key]||0) + 1;
    const el = document.getElementById('rc-' + key);
    const item = document.getElementById('ri-' + key);
    if (el) { el.textContent = rc[key]; item?.classList.add('active'); }
  }

  // ── Floating message ──
  function showFloatingMessage(text) {
    if (!text || text.trim().length === 0) return;
    const zone = document.getElementById('float-zone');
    if (!zone) return;
    const div = document.createElement('div');
    div.className = 'float-msg';
    div.innerHTML = `<div class="float-msg-text">${text.replace(/</g,'&lt;')}</div>`;
    zone.appendChild(div);
    setTimeout(() => div.remove(), 6200);
  }

  // ── Live score update ──
  function updateLiveScore(avgScore, votesCount) {
    const scoreEl = document.getElementById('proj-live-score');
    const subEl   = document.getElementById('proj-score-sub');
    const countEl = document.getElementById('proj-vote-count');

    if (scoreEl && avgScore != null) {
      scoreEl.textContent = avgScore;
      scoreEl.classList.remove('pending');
      scoreEl.classList.remove('pop');
      void scoreEl.offsetWidth; // reflow
      scoreEl.classList.add('pop');
    }

    if (subEl && votesCount != null) {
      subEl.innerHTML = `<strong>${votesCount}</strong> vote${votesCount === 1 ? '' : 's'} counted`;
    }

    if (countEl && votesCount != null) {
      countEl.textContent = votesCount;
      countEl.classList.add('flash');
      setTimeout(() => countEl.classList.remove('flash'), 600);
    }
  }

  // Auto-reload on performance change (handled by room_channel.js via .proj detection)

  // ── Hype level: aplica classe ao #hype-bg conforme total de reactions ──
  function updateHypeLevel(total) {
    const bg = document.getElementById('hype-bg');
    if (!bg) return;
    bg.classList.remove('hype-1', 'hype-2', 'hype-3');
    if      (total >= 50) bg.classList.add('hype-3');
    else if (total >= 30) bg.classList.add('hype-2');
    else if (total >= 10) bg.classList.add('hype-1');
  }

  // ── TikTok Emoji Float (projector) ──
  const PROJ_EMOJIS = { fire:'🔥', clap:'👏', crown:'👑', heart:'💖', disco:'🪩' };

  function floatEmoji(kind, zoneId) {
    const zone = document.getElementById(zoneId || 'proj-emoji-float-zone');
    if (!zone) return;
    const emoji = PROJ_EMOJIS[kind] || kind;
    spawnEmojiFloat(emoji, zone);
  }

  function spawnEmojiFloat(emoji, zone) {
    const el = document.createElement('span');
    el.className = 'ef-emoji';
    el.textContent = emoji;

    // Tamanho aleatório (grande para projector)
    const size = 48 + Math.random() * 40;           // 48–88px
    // Posição X na coluna esquerda (cantor)
    const xPct = 8 + Math.random() * 35;            // 8%–43%
    // Duração
    const dur  = 1.8 + Math.random() * 1.0;         // 1.8–2.8s
    // Sway e rotação como atributos data (não CSS vars, que podem falhar)
    const swayPx = (Math.random() - 0.5) * 80;
    const rotDeg = (Math.random() - 0.5) * 30;

    // Aplica estilos base
    el.style.fontSize        = size + 'px';
    el.style.left            = xPct + '%';
    el.style.animationDuration = dur + 's';

    // CSS vars via setProperty (correto para custom properties)
    el.style.setProperty('--sway', swayPx + 'px');
    el.style.setProperty('--rot',  rotDeg + 'deg');

    zone.appendChild(el);
    setTimeout(() => el.remove(), (dur + 0.2) * 1000);
  }
</script>
