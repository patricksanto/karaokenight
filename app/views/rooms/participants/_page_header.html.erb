<%# Partial do header superior — igual ao Stage
    Parâmetros: title (string), icon (símbolo SVG: :mic | :queue | :songs) %>

<header class="pheader">
  <div class="pheader-inner">
    <div class="pheader-left">
      <div class="pheader-icon-box">
        <% if icon == :mic %>
          <svg width="14" height="19" viewBox="0 0 14 19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="0.5" width="8" height="11" rx="4" fill="currentColor"/>
            <path d="M1 9.5C1 12.8137 3.68629 15.5 7 15.5C10.3137 15.5 13 12.8137 13 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="7" y1="15.5" x2="7" y2="18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="4.5" y1="18.5" x2="9.5" y2="18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        <% elsif icon == :queue %>
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="1" y1="1" x2="17" y2="1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="1" y1="7" x2="13" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="1" y1="13" x2="9" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        <% elsif icon == :songs %>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 13V4.5L14 3V11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="4" cy="13" r="2" fill="currentColor"/>
            <circle cx="12" cy="11.5" r="2" fill="currentColor"/>
          </svg>
        <% end %>
      </div>
      <div>
        <div class="pheader-room">ROOM <%= current_room.code %></div>
        <div class="pheader-title"><%= title %></div>
      </div>
    </div>
    <div class="pheader-avatar"><%= current_participant.emoji %></div>
  </div>
</header>

<style>
  .pheader {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: rgba(16, 12, 25, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
  }
  .pheader-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
    height: 64px;
    max-width: 480px;
    margin: 0 auto;
  }
  .pheader-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pheader-icon-box {
    width: 32px;
    height: 32px;
    background: #2C2836;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #C8F164;
    flex-shrink: 0;
  }
  .pheader-room {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C4C9B2;
    line-height: 15px;
  }
  .pheader-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.025em;
    color: #E8DFF2;
    line-height: 1.2;
  }
  .pheader-avatar {
    width: 32px;
    height: 32px;
    background: #fff;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }
</style>
