<div id="stage-content">
  <% if performance %>
    <% is_singer = performance.singers.include?(current_participant) %>
    <% if is_singer %>
      <div class="card text-center" style="background: linear-gradient(135deg, var(--color-primary), var(--color-accent));">
        <div style="font-size: 3rem; margin-bottom: 0.5rem;">🌟</div>
        <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Sua vez de brilhar!</h2>
        <p style="font-size: 1.2rem;"><strong><%= performance.song_request.title %></strong></p>
        <p class="text-muted"><%= performance.song_request.artist %></p>
      </div>
    <% else %>
      <div class="card text-center">
        <p class="text-muted" style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1rem;">Cantando agora</p>
        <div style="font-size: 2rem; margin: 0.5rem 0;"><%= performance.singers.first&.emoji || "🎤" %></div>
        <h2 style="font-size: 1.3rem;"><%= performance.singers.first&.nickname || "Cantor" %></h2>
        <p style="font-size: 1.1rem; margin-top: 0.5rem;"><strong><%= performance.song_request.title %></strong></p>
        <p class="text-muted"><%= performance.song_request.artist %></p>

        <% if performance.status == "performing" %>
          <div class="mt-2">
            <p style="color: var(--color-success); font-weight: 600;">🗳️ Votação aberta!</p>
            <%= form_with url: room_votes_path(room), method: :post, data: { turbo: false } do |f| %>
              <%= f.hidden_field :performance_id, value: performance.id %>
              <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.4rem; margin: 1rem 0;">
                <% (0..10).each do |score| %>
                  <label style="cursor: pointer;">
                    <input type="radio" name="vote[score]" value="<%= score %>" style="display: none;" required>
                    <span style="display: block; padding: 0.6rem; background: var(--color-surface-2); border-radius: 8px; text-align: center; font-weight: 600; font-size: 1.1rem; transition: background 0.15s;" onclick="this.parentElement.querySelector('input').checked=true; document.querySelectorAll('[data-score]').forEach(e=>e.style.background='var(--color-surface-2)'); this.style.background='var(--color-primary)';" data-score><%= score %></span>
                  </label>
                <% end %>
              </div>
              <div class="mb-2">
                <%= f.text_area :message, placeholder: "Mensagem (opcional)...", maxlength: 140, rows: 2 %>
              </div>
              <%= f.submit "Enviar voto", class: "btn btn-primary btn-block" %>
            <% end %>
          </div>
        <% elsif performance.status == "closing" %>
          <p style="color: var(--color-warning); font-weight: 600;">⏱️ Encerrando votação...</p>
        <% elsif performance.status == "revealed" %>
          <div class="mt-2" style="background: var(--color-surface-2); border-radius: 12px; padding: 1rem;">
            <p style="font-size: 2rem; font-weight: 700; color: var(--color-primary);"><%= performance.average_score %></p>
            <p class="text-muted"><%= performance.votes_count %> votos</p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="card text-center">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🎵</div>
      <h2>Aguardando próxima música...</h2>
      <p class="text-muted mt-1">Peça uma música ou aguarde sua vez!</p>
    </div>
  <% end %>
</div>
